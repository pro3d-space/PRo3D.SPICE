<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to this consumer project only (nuget walks up from the project
       dir). <clear/> drops any inherited sources so the restore is
       deterministic: nuget.org for the transitive Aardvark/FSharp.Core deps,
       plus the local feed CI packs the PRo3D.SPICE.0.0.0-citest.nupkg into. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Relative to this file: <repo>/bin/citest-feed -->
    <add key="local-citest" value="../../bin/citest-feed" />
  </packageSources>
</configuration>
